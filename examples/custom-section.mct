        0.1, 0.1, 0.1, 0.1
        YES, 0, 0, YES, , YES, , YES, , 0, YES, , YES, , YES, 
       OPOLY=-1, -0.75, 1, -0.75, 1, 0.75, -1, 0.75
       IPOLY=-0.75, -0.55, -0.75, 0.55, 0.75, 0.55, 0.75, -0.55

