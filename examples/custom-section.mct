;      Y1, Y2, Y3, Y4, Z1, Z2, Z3, Z4                                   ; 4th line
;      HT, BT, T1, T2                                                   ; 5th line(PSC)
;      bSHEARCHK, Z1, Z3, bAUTO_QY1, QY1, ..., TOR, bAUTO_SHR1, SHR1, ... ; 6th line(PSC)
;      OPOLY=X1, Y1, X2, Y2, ...  外轮廓（逆时针；首点不要重复）
;      IPOLY=X1, Y1, X2, Y2, ...  孔洞（顺时针），有几个写几行
